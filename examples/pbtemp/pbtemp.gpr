with "config/pbtemp_config.gpr";
project Pbtemp is

   NANOPBDIR := External ("NANOPBDIR", " ");

   for Languages use ("Ada");
   for Source_Dirs use ("src/", "config/","c_src/" , NANOPBDIR);
   for Object_Dir use "obj/" & Pbtemp_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("pbtemp.adb");

  
   package Compiler is
      for Default_Switches ("Ada") use Pbtemp_Config.Ada_Compiler_Switches;
    end Compiler;
   package Linker is
      for Default_Switches("Ada") use
         ("-Lc_src/" , "-lpbtemp") ;
   end Linker ;
   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Pbtemp;
